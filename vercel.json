{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/appbiblia",
      "destination": "/appbiblia/index.html"
    },
    {
      "source": "/appbiblia/",
      "destination": "/appbiblia/index.html"
    },
    {
      "source": "/fofuras",
      "destination": "/fofuras/index.html"
    },
    {
      "source": "/fofuras/",
      "destination": "/fofuras/index.html"
    },
    {
      "source": "/la-priere-sacree",
      "destination": "/la-priere-sacree/index.html"
    },
    {
      "source": "/la-priere-sacree/",
      "destination": "/la-priere-sacree/index.html"
    },
    {
      "source": "/priere",
      "destination": "/la-priere-sacree/index.html"
    },
    {
      "source": "/priere/",
      "destination": "/la-priere-sacree/index.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "priere.wisefull.online"
        }
      ],
      "destination": "/la-priere-sacree/index.html"
    }
  ]
}
