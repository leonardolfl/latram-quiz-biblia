{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "priere.wisefull.online"
        }
      ],
      "destination": "/la-priere-sacree",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "cigana.wisefull.online"
        }
      ],
      "destination": "/ciganavisual",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/appbiblia",
      "destination": "/appbiblia/index.html"
    },
    {
      "source": "/appbiblia/",
      "destination": "/appbiblia/index.html"
    },
    {
      "source": "/fofuras",
      "destination": "/fofuras/index.html"
    },
    {
      "source": "/fofuras/",
      "destination": "/fofuras/index.html"
    },
    {
      "source": "/la-priere-sacree",
      "destination": "/la-priere-sacree/index.html"
    },
    {
      "source": "/la-priere-sacree/",
      "destination": "/la-priere-sacree/index.html"
    },
    {
      "source": "/priere",
      "destination": "/la-priere-sacree"
    },
    {
      "source": "/priere/",
      "destination": "/la-priere-sacree"
    },
    {
      "source": "/ciganavisual",
      "destination": "/ciganavisual/index.html"
    },
    {
      "source": "/ciganavisual/",
      "destination": "/ciganavisual/index.html"
    },
    {
      "source": "/cigana",
      "destination": "/ciganavisual"
    },
    {
      "source": "/cigana/",
      "destination": "/ciganavisual"
    },
    {
      "source": "/((?!assets/).*)",
      "has": [
        {
          "type": "host",
          "value": "priere.wisefull.online"
        }
      ],
      "destination": "/la-priere-sacree"
    },
    {
      "source": "/((?!assets/).*)",
      "has": [
        {
          "type": "host",
          "value": "cigana.wisefull.online"
        }
      ],
      "destination": "/ciganavisual"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}